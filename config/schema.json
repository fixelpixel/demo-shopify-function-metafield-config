{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Demo discount configuration v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "enabled", "excludedTags", "markets"],
  "properties": {
    "version": { "const": 1 },
    "enabled": { "type": "boolean" },
    "excludedTags": {
      "type": "array", "maxItems": 20, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9 _-]{0,63}$" }
    },
    "markets": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["marketId", "currencyCode", "tiers"],
        "properties": {
          "marketId": { "type": "string", "pattern": "^gid://shopify/Market/[0-9]{1,20}$" },
          "currencyCode": { "enum": ["EUR", "USD"] },
          "tiers": {
            "type": "array", "minItems": 1, "maxItems": 10,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["minimumSubtotal", "percentage"],
              "properties": {
                "minimumSubtotal": { "type": "string", "pattern": "^(0|[1-9][0-9]{0,8})\\.[0-9]{2}$" },
                "percentage": { "type": "integer", "minimum": 1, "maximum": 100 }
              }
            }
          }
        }
      }
    }
  }
}
